<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="FotoKiosk.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FotoKiosk"
    xmlns:models="using:FotoKiosk.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="ImageGridViewItemTemplate" x:DataType="models:RollercoasterPhoto">
            <Border Width="180" Height="180"
                    Background="White"
                    BorderBrush="#DADEE3"
                    BorderThickness="2"
                    CornerRadius="4"
                    Margin="10">
                <Image Source="{x:Bind ImageSource}" Stretch="UniformToFill" />
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="TwoRowItemsPanelTemplate">
            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" />
        </ItemsPanelTemplate>
    </Page.Resources>

    <Grid RowDefinitions="*, Auto" Background="#F1F5F9">
        <GridView Grid.Row="0"
                  x:Name="ImageGridView"
                  ItemsSource="{x:Bind Images, Mode=OneWay}"
                  ItemTemplate="{StaticResource ImageGridViewItemTemplate}"
                  ItemsPanel="{StaticResource TwoRowItemsPanelTemplate}"
                  Padding="20"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  SelectionMode="Multiple"
                  SelectionChanged="ImageGridView_SelectionChanged" />

        <Grid Grid.Row="1" Background="#FFDADEE3" Height="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left Aligned Text -->
            <TextBlock Grid.Column="0"
                       Margin="10,0"
                       VerticalAlignment="Center"
                       Text="{x:Bind SelectedCountText, Mode=OneWay}" />

            <!-- Right Aligned Button Panel -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="5">
                <Button x:Name="OrderButton"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Click="OrderButton_OnClick"
                        Content="Bestellen" />
            </StackPanel>
        </Grid>

    </Grid>
</Page>