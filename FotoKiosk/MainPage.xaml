<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="FotoKiosk.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FotoKiosk"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        This is the main content area of your application.
        Add your UI elements here — for example, controls, layouts, and data-bound views.
        Use 'dotnet new winui-page' to create additional pages and navigate to them via
        the Frame in MainWindow (RootFrame).
    -->
    <Grid RowDefinitions="*, Auto" Background="#F1F5F9">
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <TextBlock
                Text="Welkom bij de Foto Kiosk!"
                FontSize="28"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,20" />
        </StackPanel>
        <StackPanel Grid.Row="1" Background="#FFDADEE3" Height="50" HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="50">

            <Button
                Content="start"
                Height="50"
                Width="250"
                Background="#2563EB"
                Click="StartButtonClicked" />
        </StackPanel>

    </Grid>
</Page>